# Template for deploy/selfhost-local/compose.yaml (docs/selfhost-local.md).
# Placeholders only. Compose refuses to start while a required value is empty.
# Copy it to .env next to compose.yaml (gitignored; never commit one). Keep the
# secrets in your password manager: set each to an op:// reference in .env and
# start with `op run --env-file deploy/selfhost-local/.env -- docker compose ...`,
# so only references are on disk and the resolved values override them.

# Public origin: scheme, host and port the client uses, no path, no trailing slash.
# It must match RH_HTTPS_PORT and a name on the edge certificate.
RH_ORIGIN=https://localhost:8443
RH_HTTPS_PORT=8443

# Certificates from scripts/selfhost-local-ca.ts, relative to this directory.
RH_PG_TLS_DIR=../../.96bulls/pg-tls
RH_EDGE_TLS_DIR=../../.96bulls/edge-tls
# The SESSION_POSTGRES_CA_SHA256 line printed for the pg-tls directory.
RH_PG_CA_SHA256=

# The one local user (not secret). The workspace is letters, digits, _ . : - only.
RH_USER_SUB=local-user
RH_USER_ORG=local-org
RH_WORKSPACE=local-workspace

# Secrets: generate each with `openssl rand -hex 32` (hex keeps them URL-safe).
RH_PG_PASSWORD=
RH_INGEST_PASSWORD=
RH_READ_PASSWORD=
RH_CONSUMER_PASSWORD=
RH_INTROSPECT_SECRET=
# The client bearer: "sh_at_" followed by `openssl rand -hex 32`.
RH_CONTROL_TOKEN=

# Optional: another services image tag (default relayhistory-services:local).
# RH_SERVICES_IMAGE=

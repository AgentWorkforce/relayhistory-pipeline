    "pg": "WITH target AS ( SELECT d.session_id, d.last_activity_at FROM sessions.session_directory AS d WHERE d.org_id = $1 AND d.workspace_id = $2 AND d.harness = $3 AND d.deleted_at IS NULL AND (d.session_id = $4 OR EXISTS ( SELECT 1 FROM sessions.session_index AS p WHERE p.org_id = d.org_id AND p.workspace_id = d.workspace_id AND p.harness = d.harness AND p.session_id = $4 AND coalesce(p.canonical_session_id, p.session_id) = d.session_id)) ORDER BY (d.session_id <> $4) DESC LIMIT 1 ) INSERT INTO sessions.session_directory_machines (org_id, workspace_id, harness, session_id, machine_id, last_activity_at) SELECT DISTINCT p.org_id, p.workspace_id, p.harness, t.session_id, coalesce(p.canonical_machine_id, p.machine_id), t.last_activity_at FROM sessions.session_index AS p CROSS JOIN target AS t WHERE p.org_id = $1 AND p.workspace_id = $2 AND p.harness = $3 AND p.session_id = $4 AND p.deleted_at IS NULL ON CONFLICT (org_id, workspace_id, harness, session_id, machine_id) DO UPDATE SET last_activity_at = excluded.last_activity_at",

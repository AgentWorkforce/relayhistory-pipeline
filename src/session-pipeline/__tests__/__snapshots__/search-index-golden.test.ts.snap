ty_at, coalesce((SELECT title FROM brief), l.title), l.project_id, l.git_repo, l.git_branch, l.model, l.state, l.event_count, l.input_tokens, l.output_tokens, l.cost_usd_micros, agg.machine_ids, agg.user_ids, sessions.session_directory_search_text( coalesce((SELECT title FROM brief), l.title), NULL, NULL, l.project_id, l.git_repo, l.git_branch, l.model, NULL), now() FROM latest AS l CROSS JOIN agg CROSS JOIN target AS t ON CONFLICT (org_id, workspace_id, harness, session_id) DO UPDATE SET created_at = LEAST(d.created_at, excluded.created_at), deleted_at = NULL, last_activity_at = excluded.last_activity_at, title = excluded.title, project_id = coalesce(excluded.project_id, d.project_id), git_repo = coalesce(excluded.git_repo, d.git_repo), git_branch = coalesce(excluded.git_branch, d.git_branch), model = excluded.model, state = excluded.state, event_count = excluded.event_count, input_tokens = excluded.input_tokens, output_tokens = excluded.output_tokens, cost_usd_micros = excluded.cost_usd_micros, machine_ids = excluded.machine_ids, user_ids = excluded.user_ids, search_text = sessions.session_directory_search_text( excluded.title, d.task_title, d.agent_name, coalesce(excluded.project_id, d.project_id), coalesce(excluded.git_repo, d.git_repo), coalesce(excluded.git_branch, d.git_branch), excluded.model, d.short_summary), projected_at = now() WHERE d.deleted_at IS NULL OR EXISTS ( -- Resurrection only for a genuinely new pointer revision: live, and strictly -- above its machine's fence (or a machine with no fence at all). SELECT 1 FROM sessions.session_index AS later WHERE later.org_id = d.org_id AND later.workspace_id = d.workspace_id AND later.harness = d.harness AND later.session_id = $4 AND later.deleted_at IS NULL AND NOT EXISTS ( SELECT 1 FROM sessions.session_directory_resurrection_fences AS f WHERE f.org_id = later.org_id AND f.workspace_id = later.workspace_id AND f.harness = later.harness AND f.session_id = d.session_id AND f.machine_id = coalesce(later.canon
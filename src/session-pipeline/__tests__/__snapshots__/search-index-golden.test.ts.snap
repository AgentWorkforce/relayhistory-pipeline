    "pg": "WITH live AS ( SELECT * FROM sessions.session_index WHERE org_id = $1 AND workspace_id = $2 AND harness = $3 AND session_id = $4 AND deleted_at IS NULL ), latest AS ( SELECT * FROM live ORDER BY last_activity_at DESC, revision DESC, machine_id DESC LIMIT 1 ), identity AS ( SELECT min(coalesce(canonical_session_id, session_id)) AS canonical_session_id FROM live HAVING count(DISTINCT coalesce(canonical_session_id, session_id)) = 1 ), target AS ( -- Do not create a duplicate while a legacy physical-id row is still live. A -- controlled re-projection removes that row first; new sessions use the source id. SELECT CASE WHEN EXISTS ( SELECT 1 FROM sessions.session_directory AS existing WHERE existing.org_id = $1 AND existing.workspace_id = $2 AND existing.harness = $3 AND existing.session_id = i.canonical_session_id) THEN i.canonical_session_id WHEN i.canonical_session_id <> $4 AND EXISTS ( SELECT 1 FROM sessions.session_directory AS legacy WHERE legacy.org_id = $1 AND legacy.workspace_id = $2 AND legacy.harness = $3 AND legacy.session_id = $4) THEN $4 ELSE i.canonical_session_id END AS session_id FROM identity AS i ), brief AS ( SELECT title FROM sessions.session_briefs WHERE org_id = $1 AND workspace_id = $2 AND harness = $3 AND session_id = $4 AND title IS NOT NULL ), agg AS ( SELECT min(created_at) AS created_at, max(last_activity_at) AS last_activity_at, coalesce(array_agg(DISTINCT coalesce(canonical_machine_id, machine_id) ORDER BY coalesce(canonical_machine_id, machine_id)), '{}') AS machine_ids, coalesce(array_agg(DISTINCT user_id ORDER BY user_id) FILTER (WHERE user_id <> 'unknown'), '{}') AS user_ids FROM live ) INSERT INTO sessions.session_directory AS d (org_id, workspace_id, harness, session_id, created_at, last_activity_at, title, project_id, git_repo, git_branch, model, state, event_count, input_tokens, output_tokens, cost_usd_micros, machine_ids, user_ids, search_text, projected_at) SELECT $1, $2, $3, t.session_id, agg.created_at, agg.last_activity_at, coalesce((SELECT title FROM brief), l.title), l.project_id, l.git_repo, l.git_branch, l.model, l.state, l.event_count, l.input_tokens, l.output_tokens, l.cost_usd_micros, agg.machine_ids, agg.user_ids, sessions.session_directory_search_text( coalesce((SELECT title FROM brief), l.title), NULL, NULL, l.project_id, l.git_repo, l.git_branch, l.model, NULL), now() FROM latest AS l CROSS JOIN agg CROSS JOIN target AS t ON CONFLICT (org_id, workspace_id, harness, session_id) DO UPDATE SET created_at = LEAST(d.created_at, excluded.created_at), deleted_at = NULL, last_activity_at = excluded.last_activity_at, title = excluded.title, project_id = coalesce(excluded.project_id, d.project_id), git_repo = coalesce(excluded.git_repo, d.git_repo), git_branch = coalesce(excluded.git_branch, d.git_branch), model = excluded.model, state = excluded.state, event_count = excluded.event_count, input_tokens = excluded.input_tokens, output_tokens = excluded.output_tokens, cost_usd_micros = excluded.cost_usd_micros, machine_ids = excluded.machine_ids, user_ids = excluded.user_ids, search_text = sessions.session_directory_search_text( excluded.title, d.task_title, d.agent_name, coalesce(excluded.project_id, d.project_id), coalesce(excluded.git_repo, d.git_repo), coalesce(excluded.git_branch, d.git_branch), excluded.model, d.short_summary), projected_at = now() WHERE d.deleted_at IS NULL OR EXISTS ( -- Resurrection only for a genuinely new pointer revision: live, and strictly -- above its machine's fence (or a machine with no fence at all). SELECT 1 FROM sessions.session_index AS later WHERE later.org_id = d.org_id AND later.workspace_id = d.workspace_id AND later.harness = d.harness AND later.session_id = $4 AND later.deleted_at IS NULL AND NOT EXISTS ( SELECT 1 FROM sessions.session_directory_resurrection_fences AS f WHERE f.org_id = later.org_id AND f.workspace_id = later.workspace_id AND f.harness = later.harness AND f.session_id = d.session_id AND f.machine_id = coalesce(later.canonical_machine_id, later.machine_id) AND f.revision >= later.revision)) RETURNING true AS projected",

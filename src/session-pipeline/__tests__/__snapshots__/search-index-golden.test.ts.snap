    "pg": "INSERT INTO sessions.session_index_ext (org_id, workspace_id, harness, session_id, machine_id, session_uuid, session_uuid_source, tenant_id, user_id, first_trace_id, last_trace_id, last_revision) VALUES ($1,$2,$3,$4,$5,$6::uuid,$7,$8,$9,$10::uuid,$10::uuid,$11) ON CONFLICT (org_id, workspace_id, harness, session_id, machine_id) DO UPDATE SET last_trace_id = excluded.last_trace_id, last_revision = greatest(sessions.session_index_ext.last_revision, excluded.last_revision), user_id = coalesce(excluded.user_id, sessions.session_index_ext.user_id), updated_at = now()",

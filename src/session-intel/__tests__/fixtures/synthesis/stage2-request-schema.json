{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "initiatives",
    "themes",
    "hypotheses"
  ],
  "properties": {
    "initiatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "goal",
          "sessions",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alias",
                "titleRef"
              ],
              "properties": {
                "alias": {
                  "type": "string"
                },
                "titleRef": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "kind",
          "sessions",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "recurring_issue",
              "workflow",
              "topic"
            ]
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alias",
                "titleRef"
              ],
              "properties": {
                "alias": {
                  "type": "string"
                },
                "titleRef": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "basis",
          "impact"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string",
            "enum": [
              "unmeasured"
            ]
          }
        }
      }
    }
  }
}

{
  "name": "sessions-pipeline",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "96Bulls: infrastructure and services for the Agent Relay sessions pipeline. One entry point brings the whole pipe up or down.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.11.1"
  },
  "bin": {
    "96bulls": "bin/96bulls"
  },
  "scripts": {
    "build": "bun run --filter @relayhistory/object-store build",
    "typecheck": "tsc --noEmit && bun run --filter @96bulls/pipeline typecheck && bun run --filter @relayhistory/object-store typecheck && bun run --filter @96bulls/session-read-worker typecheck",
    "test": "bun test && bun test ./stacks && bun run --filter @96bulls/pipeline test && bun run --filter @relayhistory/object-store test",
    "up:local": "bun run bin/96bulls up local",
    "down:local": "bun run bin/96bulls down local",
    "smoke:local": "bun run bin/96bulls smoke local",
    "audit:search-indexes": "bun run src/hoopdb/search-index-audit.ts",
    "benchmark:relayhistory": "bun run src/migration/relayhistory-benchmark.ts",
    "proof:aws": "bun run src/proof/aws/cli.ts",
    "proof:aws:teardown": "bun run src/proof/aws/cli.ts teardown",
    "benchmark:relayhistory-api": "bun run src/migration/relayhistory-api-benchmark.ts",
    "migration:copy": "bun run src/migration/relayhistory-copy.ts",
    "migration:neon-fence": "bun run src/migration/relayhistory-neon-fence.ts",
    "migration:rebuild": "bun run src/migration/relayhistory-rebuild.ts",
    "migration:reproject": "bun run src/migration/relayhistory-reproject.ts",
    "migration:reverse": "bun run src/migration/relayhistory-reverse.ts",
    "migration:sequence-fence": "bun run src/migration/relayhistory-sequence-fence.ts",
    "migration:verify": "bun run src/migration/relayhistory-verify.ts",
    "migration:neon-s3-sync": "bun run src/migration/neon-s3-sync/main.ts",
    "migration:neon-s3-erasure": "bun run src/migration/neon-s3-erasure/main.ts",
    "e2e:selfhost": "bun run e2e/selfhost/run.ts"
  },
  "dependencies": {
    "@96bulls/pipeline": "workspace:*",
    "@alchemy.run/aws": "2.0.0-beta.84",
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/docker": "2.0.0-beta.84",
    "@alchemy.run/gcp": "2.0.0-beta.84",
    "@alchemy.run/kubernetes": "2.0.0-beta.84",
    "@distilled.cloud/cloudflare": "1.0.0-rc.17",
    "@effect/platform-bun": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@relayhistory/object-store": "workspace:*",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.7",
    "hono": "4.12.26",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@types/bun": "latest",
    "@types/node": "24",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}

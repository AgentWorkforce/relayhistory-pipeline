{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "paths": {
      "@rhc/*": ["../pipeline/src/*"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["test/global-setup.ts", "test/ported"]
}

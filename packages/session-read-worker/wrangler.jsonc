{
  // 96Bulls session read API on Cloudflare Workers (account Agent Workforce).
  // Deployed only by .github/workflows/deploy-session-read-worker.yml, which
  // fills the Hyperdrive id and the vars below from GitHub environment
  // variables. Secrets (CLICKHOUSE_URL, CLICKHOUSE_USER, CLICKHOUSE_PASSWORD)
  // are set out of band with `wrangler secret put` and survive deploys.
  // See runbooks/sessions-prod-session-read-worker.md.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bulls96-session-read-api",
  "account_id": "f7232cb80f6fab86a95426302af243e4",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloud invokes this Worker from another Worker on the same account. A
  // workers.dev origin can fail that hop with Cloudflare error 1042, so the
  // production service is custom-domain-only.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "sessions-read.agentrelay.com", "custom_domain": true }
  ],
  // Every request makes two ClickHouse round trips and up to two Supabase
  // transactions, all in AWS us-east-1: run next to them, not next to Cloud.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "SUPABASE",
      // Placeholder; the deploy workflow substitutes vars.SESSION_READ_HYPERDRIVE_ID
      // and refuses to deploy while it is unset. Hyperdrive ids are not secret.
      // Local runs take the connection string from
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_SUPABASE (never a file).
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "CLICKHOUSE_DATABASE": "relay_search",
    // Production RelayAuth, the values relayhistory-cloud and the Lambda deploy with
    // (stacks/aws/session-read-api.ts, #158). The shared verifier's fallback JWKS,
    // https://relayauth.dev/.well-known/jwks.json, does not resolve: unset, every
    // token fails the JWKS fetch and Cloud sees only 401s.
    "RELAYAUTH_JWKS_URL": "https://api.relayauth.dev/.well-known/jwks.json",
    "RELAYAUTH_ISSUER": "https://relayauth.dev",
    // Fail closed until the deploy workflow sets them: no origin = every /v1
    // request 401; no completeSince = every request 503.
    "READ_API_ORIGIN": "",
    "READ_API_COMPLETE_SINCE": "",
    // The directory list/activity canary allowlist (P3b). Empty = every workspace gets
    // 501 directory_workspace_not_enabled (Cloud keeps its current path); "*" = all;
    // else comma-separated workspace ids. The deploy workflow sets it from
    // vars.SESSION_READ_DIRECTORY_WORKSPACES (unset = empty).
    "READ_API_DIRECTORY_WORKSPACES": "",
    // The brief-titles allowlist (F2, GET /v1/sessions/titles). Empty = every workspace gets
    // 501 brief_titles_workspace_not_enabled; "*" = all; else comma-separated workspace ids.
    // The deploy workflow sets it from vars.SESSION_READ_BRIEF_TITLES_WORKSPACES (unset = empty).
    "READ_API_BRIEF_TITLES_WORKSPACES": ""
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/index.ts",
    "src/gateway.ts",
    "src/native-server.ts",
    "scripts/render-config.ts"
  ]
}

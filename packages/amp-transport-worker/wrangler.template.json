{
  "name": "96bulls-amp-transport",
  "account_id": "__OPERATOR_ACCOUNT_ID_REQUIRED__",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "__OPERATOR_HOSTNAME_REQUIRED__",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "name": "amp-transport",
      "class_name": "AmpTransport",
      "image": "__APPROVED_IMAGE_DIGEST_REQUIRED__",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AMP_TRANSPORT",
        "class_name": "AmpTransport"
      }
    ]
  },
  "exports": {
    "AmpTransport": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}

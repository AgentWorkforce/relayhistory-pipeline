  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "amp-transport.agentrelay.com", "custom_domain": true }],
  "containers": [{
    "class_name": "AmpTransport",
    "image": "__APPROVED_IMAGE_DIGEST_REQUIRED__",
    "instance_type": "basic",
    "max_instances": 1

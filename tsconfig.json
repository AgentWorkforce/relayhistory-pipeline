{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "@rhc/*": [
        "./packages/pipeline/src/*"
      ],
      "@rhc-object-store": [
        "./packages/object-store/src/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "src",
    "stacks",
    "alchemy.run.ts",
    "smoke",
    "src/types/*.d.ts",
    "scripts/proof-buffer-gc.ts",
    "scripts/sync-ingest-buffer-gc-boundary.ts",
    "scripts/session-ingest-seed.ts",
    "scripts/proof-ingest-s3-seed.ts",
    "scripts/sync-ingest-seed-boundary.ts",
    "scripts/schema-release-*.ts",
    "scripts/pg-proof/schema-rehearsal*.ts",
    "scripts/proof-buffered-gc-runtime.ts",
    "scripts/native-agent-catalog-activation.ts",
    "scripts/proof-native-agent-catalog-activation.ts",
    "scripts/proof-ordered-controls.ts",
    "scripts/sync-ingest-control-boundary.ts",
    "scripts/build-ordered-router-fixture.ts",
    "scripts/generate-ordered-control-neon-fixture.ts",
    "scripts/proof-receipt-seats.ts",
    "scripts/sync-ingest-seat-boundary.ts",
    "scripts/sync-ingest-custody-boundary.ts",
    "scripts/sync-ingest-lazy-boundary.ts",
    "scripts/proof-lazy-current-custody.ts",
    "scripts/build-lazy-custody-source-fixture.ts",
    "scripts/sync-sessions-function-boundary.ts",
    "scripts/sync-ingest-history-boundary.ts",
    "scripts/sessions-function-boundary",
    "scripts/opensearch-proof",
    "scripts/upload-fence-backfill.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "packages",
    "**/__tests__/**"
  ]
}
